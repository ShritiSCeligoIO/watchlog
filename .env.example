# TMDB movie search — set at repo root (.env), not under src/
# Vite dev server loads this file; TMDB_API_KEY works in the browser (no VITE_ prefix required)
# Optional alias: VITE_TMDB_API_KEY (same value)
# Get a free key: https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Optional — Open Library base URL (defaults to https://openlibrary.org)
# OPEN_LIBRARY_BASE_URL=https://openlibrary.org
# VITE_OPEN_LIBRARY_BASE_URL=https://openlibrary.org
