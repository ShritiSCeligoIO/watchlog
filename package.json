{
  "name": "watchlog",
  "version": "0.1.0",
  "description": "Personal movie and book watchlist — UI dev learning path",
  "type": "module",
  "engines": {
    "node": "22.11.0"
  },
  "scripts": {
    "dev": "webpack serve --mode development",
    "dev:remote": "webpack serve --mode development",
    "dev:host": "npm --prefix host run dev",
    "dev:mfe": "concurrently -n remote,host \"npm:dev:remote\" \"npm:dev:host\"",
    "gateway": "node gateway/server.js",
    "build": "rm -rf dist && tsc -p tsconfig.lib.json",
    "build:app": "webpack --mode production",
    "build:host": "npm --prefix host run build",
    "build:mfe": "npm run build:app && npm run build:host",
    "build:lib": "rm -rf dist && tsc -p tsconfig.lib.json",
    "analyze": "npm run analyze:app && npm run analyze:host",
    "analyze:app": "webpack --mode production --env analyze",
    "analyze:host": "npm --prefix host run analyze",
    "install:host": "npm --prefix host install",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && npm --prefix host run typecheck",
    "typecheck:locales": "tsc -p tsconfig.locales.json --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.6",
    "@radix-ui/react-label": "2.1.2",
    "@radix-ui/react-radio-group": "1.2.3",
    "@radix-ui/react-select": "2.1.6",
    "@radix-ui/react-slot": "1.1.2",
    "@radix-ui/react-tabs": "1.1.3",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-query-devtools": "5.102.8",
    "clsx": "2.1.1",
    "i18next": "26.4.2",
    "i18next-browser-languagedetector": "8.2.1",
    "i18next-resources-to-backend": "1.2.3",
    "immer": "11.1.18",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-i18next": "17.0.13",
    "react-router-dom": "6.28.0",
    "tailwind-merge": "2.6.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@babel/core": "7.26.9",
    "@babel/preset-env": "7.26.9",
    "@babel/preset-react": "7.26.3",
    "@babel/preset-typescript": "7.26.0",
    "@types/node": "22.13.10",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "autoprefixer": "10.4.21",
    "babel-loader": "9.2.1",
    "concurrently": "9.1.2",
    "cors": "2.8.5",
    "css-loader": "7.1.2",
    "css-minimizer-webpack-plugin": "7.0.0",
    "dotenv": "16.4.7",
    "dotenv-webpack": "8.1.0",
    "express": "4.21.2",
    "html-webpack-plugin": "5.6.3",
    "jsdom": "26.0.0",
    "mini-css-extract-plugin": "2.9.2",
    "postcss": "8.5.3",
    "postcss-loader": "8.1.1",
    "style-loader": "4.0.0",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3",
    "vitest": "3.0.5",
    "webpack": "5.97.1",
    "webpack-bundle-analyzer": "4.10.2",
    "webpack-cli": "6.0.1",
    "webpack-dev-server": "5.2.0"
  }
}
