{
  "name": "watchlog",
  "version": "0.1.0",
  "description": "Personal movie and book watchlist — UI dev learning path",
  "type": "module",
  "engines": {
    "node": "22.11.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "rm -rf dist && tsc -p tsconfig.lib.json",
    "build:app": "vite build",
    "build:lib": "rm -rf dist && tsc -p tsconfig.lib.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "typecheck:locales": "tsc -p tsconfig.locales.json --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.6",
    "@radix-ui/react-label": "2.1.2",
    "@radix-ui/react-radio-group": "1.2.3",
    "@radix-ui/react-select": "2.1.6",
    "@radix-ui/react-slot": "1.1.2",
    "@radix-ui/react-tabs": "1.1.3",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-query-devtools": "5.102.8",
    "clsx": "2.1.1",
    "i18next": "26.4.2",
    "i18next-browser-languagedetector": "8.2.1",
    "i18next-resources-to-backend": "1.2.3",
    "immer": "11.1.18",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-i18next": "17.0.13",
    "react-router-dom": "6.28.0",
    "tailwind-merge": "2.6.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/node": "22.13.10",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.21",
    "dotenv": "16.4.7",
    "jsdom": "26.0.0",
    "postcss": "8.5.3",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3",
    "vite": "6.0.11",
    "vitest": "3.0.5"
  }
}
